<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Developers keep the real connection string here, outside the repository:
         dotnet user-secrets set "ConnectionStrings:MeterReading" "Server=...;Password=..." -->
    <UserSecretsId>meterreading-api-6f1c2b4a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.0" />
    <!-- Comes in through SqlClient/Identity; 10.0.10 has advisories GHSA-846f-f764-76mx (high) and
         GHSA-2fmv-rv2c-59x7 (moderate). Pinned to the patched release until they bring it themselves. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Android-only texts: the launcher name and the "Signal is back" notification, which Android shows
  outside the app. Every text on the app's screens is in commonMain/composeResources/values/strings.xml
  (shared with iOS); keep these the same as there.
-->
<resources>
    <string name="app_name">DIP Field Service</string>
    <string name="sync_channel">Readings waiting to send</string>
    <string name="sync_title">Signal is back</string>
    <string name="sync_text">Waiting on the phone: %1$d readings, %2$d photos. Send them now?</string>
    <string name="sync_now">Send now</string>
    <string name="sync_later">Later</string>
</resources>

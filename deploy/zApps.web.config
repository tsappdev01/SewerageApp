<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for the DMZ gateway site zApps (https://zApps.dipark.com/). Holds no password.
  Self-contained publish, so IIS starts the .exe. Replace GW_THUMB with the thumbprint of the gateway's
  client certificate (CN=zApps-gateway in LocalMachine\My on this server).
  Gateway:ApiBaseUrl (https://mApps.dipark.com/) comes from appsettings.json. ApiCertificateThumbprint is
  left empty: the *.dipark.com wildcard is checked by its chain and name, so renewing it needs no change here.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\MeterReading.Gateway.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="Gateway__ClientCertificate__Thumbprint" value="GW_THUMB" />
        </environmentVariables>
      </aspNetCore>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
    </system.webServer>
  </location>
</configuration>

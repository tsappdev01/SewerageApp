<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for the DMZ gateway site zApps (https://zApps.dipark.com/). Holds no password and needs no
  editing: copy it into the published folder as web.config. Self-contained publish, so IIS starts the .exe.
  Gateway:ApiBaseUrl (https://mApps.dipark.com/) comes from appsettings.json. No client certificate
  (DIP decision 2026-10-12): phones authenticate by registration. ApiCertificateThumbprint is left
  empty: the GoDaddy *.dipark.com wildcard is checked by its chain and name, so renewing it needs no change.
  The last two blocks remove IIS's own Server and X-Powered-By headers.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\MeterReading.Gateway.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
    </system.webServer>
  </location>
</configuration>

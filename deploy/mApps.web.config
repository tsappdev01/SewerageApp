<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for the internal API site mApps (UATWEB01, C:\Websites\mApps, https://mApps.dipark.com/).
  Self-contained publish (Properties/PublishProfiles/FolderProfile.pubxml), so IIS starts the .exe, not "dotnet".
  Copy to C:\Websites\mApps\web.config and replace the three placeholders ON THE SERVER only:
    MR_API_PASSWORD   mr_api's password (escape & < " as &amp; &lt; &quot;)
    DMZ_IP            the gateway's address as UATWEB01 sees it (c-ip in the IIS log)
    GW_THUMB          the gateway client certificate's thumbprint (CN=zApps-gateway)
    OFFICE_LAT/LON    the DIP office's latitude and longitude
  Never commit the filled-in copy.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\MeterReading.Api.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ConnectionStrings__MeterReading" value="Server=UATWEB01;Database=MRDB;User Id=mr_api;Password=MR_API_PASSWORD;Encrypt=True;TrustServerCertificate=True;Application Name=MeterReadingApi" />
          <environmentVariable name="Auth__Mode" value="Device" />
          <environmentVariable name="PmsTransfer__Enabled" value="false" />
          <!-- The DIP office, for each property's distance (spec FR-031.2). Decimal degrees, e.g. 25.0012 / 55.1534. -->
          <environmentVariable name="Inspection__OfficeLatitude" value="OFFICE_LAT" />
          <environmentVariable name="Inspection__OfficeLongitude" value="OFFICE_LON" />
          <!-- Only the gateway gets in (gateway/README.md, part 3). -->
          <environmentVariable name="Gateway__KnownProxies__0" value="DMZ_IP" />
          <environmentVariable name="Gateway__RequireClientCertificate" value="true" />
          <environmentVariable name="Gateway__ClientCertificateThumbprints__0" value="GW_THUMB" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
